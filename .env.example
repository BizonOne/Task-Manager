APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# Timestamps are stored in APP_TIMEZONE and read in this one.
APP_DISPLAY_TIMEZONE=Europe/Riga
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Demo account created by DemoUserSeeder (defaults shown)
# DEMO_USER_EMAIL=admin@example.com
# DEMO_USER_PASSWORD=secret
# DEMO_USER_NAME="Arafat Hossain"

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=task
DB_USERNAME=root
DB_PASSWORD=

# Lina, the built-in assistant, runs on Google Gemini.
# Without a key the chat politely reports that it is not configured.
GEMINI_API_KEY=
# Optional: comma-separated, tried in order.
# GEMINI_MODELS=gemini-2.5-flash,gemini-flash-latest,gemini-2.5-pro

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Email notifications via Resend (resend/resend-laravel).
# Set MAIL_MAILER=resend, add your Resend API key, and use a verified
# sending domain for MAIL_FROM_ADDRESS.
# MAIL_MAILER=resend
RESEND_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Jira import (php artisan jira:import). JIRA_TOKEN is an Atlassian API
# token created at https://id.atlassian.com/manage-profile/security/api-tokens
# and used as the password for JIRA_USER.
JIRA_URL=https://your-site.atlassian.net
JIRA_USER=
JIRA_TOKEN=

# Telegram notification bot (php artisan telegram:webhook --set).
# TELEGRAM_WEBHOOK_SECRET is a random string Telegram echoes back on every
# update; it is what makes the public webhook endpoint safe.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
